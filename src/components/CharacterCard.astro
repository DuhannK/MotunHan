---
import TierBadge from './TierBadge.astro';
import { asset } from '../lib/href';
import { foldTr } from '../lib/text';
import type { CollectionEntry } from 'astro:content';

interface Props {
  character: CollectionEntry<'characters'>;
  /** Oyun adı — karakter listesi sayfasında hangi oyuna ait olduğu görünsün. */
  gameTitle?: string;
}

const { character, gameTitle } = Astro.props;
const { name, tier, rarity, image, howToGet, element, description } = character.data;
---

<article
  class="ccard card"
  data-character
  data-name={foldTr(name)}
  data-tier={tier}
  data-game={character.data.game}
  data-rarity={foldTr(rarity)}
>
  <div class="ccard__head">
    {image ? (
      <img class="ccard__img" src={asset(image)} alt={name} width="72" height="72" loading="lazy" />
    ) : (
      <div class="ccard__initial" aria-hidden="true">{name.charAt(0)}</div>
    )}

    <div class="ccard__id">
      <h3 class="ccard__name">{name}</h3>
      <p class="ccard__rarity">{rarity}{element ? ` · ${element}` : ''}</p>
      {gameTitle && <p class="ccard__game">{gameTitle}</p>}
    </div>

    <TierBadge tier={tier} />
  </div>

  {description && <p class="ccard__desc">{description}</p>}

  <div class="ccard__get">
    <span class="ccard__get-label">Nasıl alınır?</span>
    <p class="ccard__get-text">{howToGet}</p>
  </div>
</article>

<style>
  .ccard {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    padding: var(--sp-4);
    height: 100%;
  }

  .ccard__head { display: flex; align-items: center; gap: var(--sp-3); }

  .ccard__img,
  .ccard__initial {
    width: 60px;
    height: 60px;
    flex: none;
    border-radius: var(--r-md);
    object-fit: cover;
  }

  .ccard__initial {
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, var(--accent), color-mix(in oklab, var(--accent) 40%, #000));
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 700;
    color: #fff;
  }

  .ccard__id { flex: 1; min-width: 0; }

  .ccard__name { font-size: var(--fs-lg); line-height: 1.2; }

  .ccard__rarity {
    color: var(--accent-2);
    font-size: var(--fs-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .ccard__game { color: var(--ink-dim); font-size: var(--fs-xs); }

  .ccard__desc { color: var(--ink-soft); font-size: var(--fs-sm); }

  .ccard__get {
    margin-top: auto;
    padding: var(--sp-3);
    background: var(--bg-3);
    border-radius: var(--r-md);
    border-left: 4px solid var(--accent);
  }

  .ccard__get-label {
    display: block;
    margin-bottom: var(--sp-1);
    font-family: var(--font-display);
    font-size: var(--fs-xs);
    font-weight: 700;
    color: var(--accent-2);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .ccard__get-text { font-size: var(--fs-sm); color: var(--ink-soft); }
</style>
