---
import { href, asset } from '../lib/href';
import { thumbnailUrl } from '../lib/videos';
import { DIFFICULTIES } from '../lib/constants';
import type { CollectionEntry } from 'astro:content';

interface Props {
  game: CollectionEntry<'games'>;
  /** O oyuna ait rehber sayısı — kartta gösterilir. */
  guideCount?: number;
  videoCount?: number;
}

const { game, guideCount = 0, videoCount = 0 } = Astro.props;
const { title, tagline, cover, accentColor, genre, difficulty, featuredVideoId, isNew } = game.data;

/**
 * Kapak görseli: elle verilmişse onu kullan, yoksa öne çıkan videonun
 * YouTube thumbnail'ini kullan. Böylece görsel hazırlanmadan da site
 * gerçek oyun görüntüsüyle dolu görünüyor.
 */
const coverSrc = cover
  ? asset(cover)
  : featuredVideoId
    ? thumbnailUrl(featuredVideoId, 'sd')   // kart ~370px, maxres israf
    : null;

const diff = DIFFICULTIES[difficulty];
---

<a
  class="gcard card tilt"
  href={href(`/oyunlar/${game.id}`)}
  style={`--accent:${accentColor}`}
  aria-label={`${title} — oyun sayfasına git`}
>
  <div class="gcard__media">
    {coverSrc ? (
      <img
        class="gcard__img"
        src={coverSrc}
        alt=""
        width="640"
        height="360"
        loading="lazy"
        decoding="async"
        transition:name={`game-cover-${game.id}`}
      />
    ) : (
      <div class="gcard__fallback" transition:name={`game-cover-${game.id}`}>
        <span>{title.charAt(0)}</span>
      </div>
    )}

    <div class="gcard__badges">
      {isNew && <span class="badge badge-new">✨ YENİ</span>}
      <span class="badge" style={`--accent:${diff.color}`}>{diff.label}</span>
    </div>
  </div>

  <div class="gcard__body">
    <h3 class="gcard__title" transition:name={`game-title-${game.id}`}>{title}</h3>
    <p class="gcard__tagline">{tagline}</p>

    <ul class="gcard__genre">
      {genre.slice(0, 3).map((g) => <li>{g}</li>)}
    </ul>

    <div class="gcard__foot">
      <span class="gcard__stat">📘 {guideCount} rehber</span>
      <span class="gcard__stat">🎬 {videoCount} video</span>
      <span class="gcard__go" aria-hidden="true">Keşfet →</span>
    </div>
  </div>
</a>

<style>
  .gcard {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  .gcard__media { position: relative; aspect-ratio: 16 / 9; overflow: hidden; background: var(--bg-3); }

  .gcard__img { width: 100%; height: 100%; object-fit: cover; transition: transform var(--t-slow) var(--ease-out); }
  .gcard:hover .gcard__img { transform: scale(1.07); }

  .gcard__fallback {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, var(--accent), color-mix(in oklab, var(--accent) 30%, #000));
    font-family: var(--font-display);
    font-size: 4rem;
    font-weight: 700;
    color: #fff;
  }

  .gcard__badges {
    position: absolute;
    top: var(--sp-3);
    left: var(--sp-3);
    display: flex;
    gap: var(--sp-2);
    flex-wrap: wrap;
  }

  .gcard__badges .badge { background: rgb(10 8 26 / 0.82); backdrop-filter: blur(6px); }

  .gcard__body { display: flex; flex-direction: column; gap: var(--sp-2); padding: var(--sp-5); flex: 1; }

  .gcard__title { font-size: var(--fs-xl); color: var(--ink); }

  .gcard__tagline { color: var(--ink-soft); font-size: var(--fs-sm); }

  .gcard__genre {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .gcard__genre li {
    padding: 0.2em 0.65em;
    background: var(--accent-soft);
    border-radius: var(--r-pill);
    font-size: var(--fs-xs);
    font-weight: 700;
    color: var(--ink-soft);
  }

  .gcard__foot {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    margin-top: auto;
    padding-top: var(--sp-3);
    border-top: 1px solid rgb(255 255 255 / 0.08);
    font-size: var(--fs-xs);
    font-weight: 700;
    color: var(--ink-dim);
    flex-wrap: wrap;
  }

  .gcard__go {
    margin-left: auto;
    color: var(--accent-2);
    transition: transform var(--t-mid) var(--ease-out);
  }

  .gcard:hover .gcard__go { transform: translateX(5px); }
</style>
