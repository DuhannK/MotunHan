---
interface Props {
  tier: 'S' | 'A' | 'B' | 'C' | 'D';
  size?: 'sm' | 'md';
}

const { tier, size = 'md' } = Astro.props;

/** Tier açıklamaları — çocuk için ne anlama geldiği net olsun. */
const LABELS: Record<Props['tier'], string> = {
  S: 'En güçlü',
  A: 'Çok iyi',
  B: 'İyi',
  C: 'Orta',
  D: 'Zayıf',
};
---

<span class={`tier tier--${tier.toLowerCase()} tier--${size}`} title={`${tier} Tier — ${LABELS[tier]}`}>
  <span class="tier__letter">{tier}</span>
  <span class="visually-hidden">Tier {tier} — {LABELS[tier]}</span>
</span>

<style>
  .tier {
    display: inline-grid;
    place-items: center;
    flex: none;
    font-family: var(--font-display);
    font-weight: 700;
    line-height: 1;
    color: #0b0a1a;
    border-radius: var(--r-md);
    box-shadow: 0 3px 12px rgb(0 0 0 / 0.35);
  }

  .tier--md { width: 40px; height: 40px; font-size: 1.25rem; }
  .tier--sm { width: 30px; height: 30px; font-size: 0.95rem; border-radius: var(--r-sm); }

  .tier--s { background: linear-gradient(135deg, #fde68a, var(--tier-s)); }
  .tier--a { background: linear-gradient(135deg, #fbcfe8, var(--tier-a)); }
  .tier--b { background: linear-gradient(135deg, #ddd6fe, var(--tier-b)); }
  .tier--c { background: linear-gradient(135deg, #bae6fd, var(--tier-c)); }
  .tier--d { background: linear-gradient(135deg, #e2e8f0, var(--tier-d)); }
</style>
